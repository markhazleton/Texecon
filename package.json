{
  "name": "texecon-static",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && npm run fetch:content && npm run generate:sitemap && vite build && npm run generate:static-pages",
    "preview": "vite preview",
    "refresh:content": "node scripts/refresh-content.js",
    "fetch:content": "node scripts/fetch-content.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:static-pages": "node scripts/generate-static-pages.js",
    "optimize:gallery": "node scripts/optimize-gallery.js",
    "video:editor": "python videos/collage-editor.py",
    "video:render": "python videos/create-collage.py",
    "type-check": "tsc --noEmit",
    "clean": "node scripts/clean.js",
    "start": "npm run clean && npm run fetch:content && npm run generate:sitemap && vite build && npm run generate:static-pages && vite preview",
    "lint": "eslint client/src --ext .ts,.tsx",
    "lint:fix": "eslint client/src --ext .ts,.tsx --fix",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
